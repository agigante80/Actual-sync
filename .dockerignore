# Version control
.git
.gitignore
.gitattributes

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
*.test.js
__tests__

# Development files
*.md
!README.md
.vscode
.idea
*.swp
*.swo
*~

# Documentation (except README)
docs

# NOTE: config/config.example.json is intentionally NOT ignored — it is bundled
# into the image (config-defaults) and seeded into the config volume on first
# run so new users get a template to fill in. (#96)

# Local data and logs (will be mounted as volumes)
data
logs
*.log
*.db
*.db-journal
*.db-shm
*.db-wal

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp
temp
*.tmp

# Build artifacts
dist
build

# Docker files (not needed inside container)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Scripts not needed in production
scripts/test*.js

# Mutation testing tooling (#180). validateConfig.js DOES ship — `npm run
# validate-config` in the container is the documented pre-upgrade check (#177) —
# so scripts/ cannot be excluded wholesale. These two rewrite source files in
# place and have no business in a production image.
scripts/mutationTest.js
scripts/mutations.js

# Build-time and release-time only (#183). listAccounts.js and viewHistory.js
# stay — they back `npm run list-accounts` and `npm run history`, which
# operators run inside the container.
#   generateDashboardScreenshots.js needs puppeteer, a devDependency the image
#     omits, so it can only crash.
#   generate-badges.js writes to .github/badges, absent from the image.
#   version-bump.js rewrites VERSION, package.json and package-lock.json.
#   defaultBranchDrift.js diffs the checkout against origin/main; there is no
#     git repository in the image, so it can only fail (#204).
scripts/generateDashboardScreenshots.js
scripts/generate-badges.js
scripts/version-bump.js
scripts/defaultBranchDrift.js

# Backup files
*.backup
*.bak
*~

# IDE
*.sublime-*
*.code-workspace
