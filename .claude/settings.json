{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-host-paths.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for machine-specific paths"
          }
        ]
      }
    ]
  }
}
